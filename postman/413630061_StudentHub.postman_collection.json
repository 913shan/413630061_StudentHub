{
  "info": {
    "name": "413630061_StudentHub",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "查詢全部學生",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:8890/api/v1/user/findAll"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test(\"code 200\", () => pm.expect(result.code).to.eql(200));",
              "pm.test(\"學生清單\", () => { pm.expect(result.body).to.be.an(\"array\"); pm.expect(result.body.length).to.be.at.least(50); });"
            ]
          }
        }
      ]
    },
    {
      "name": "新增測試學生（只送一次）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8890/api/v1/user/insertOne",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userName\": \"413630061\",\n  \"name\": \"鄒采珊\",\n  \"department\": \"資訊管理系\",\n  \"grade\": \"三年級\",\n  \"class\": \"C\",\n  \"Email\": \"zcs0913@gmail.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test(\"code 200\", () => pm.expect(result.code).to.eql(200));",
              "pm.test(\"新增學生欄位\", () => { pm.expect(result.body.userName).to.eql(JSON.parse(pm.request.body.raw).userName); pm.expect(result.body.sid).to.be.a(\"string\"); pm.expect(result.body._id).to.match(/^[a-f0-9]{24}$/); });"
            ]
          }
        }
      ]
    }
  ]
}
