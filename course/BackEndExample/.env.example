# 複製為 .env，填入你建立的 MongoDB 帳號密碼，勿提交 .env。
DBUSER=studenthub_app
DBPASSWORD=replace_with_your_database_password
DBHOST=127.0.0.1
DBPORT=27017
DBNAME=studenthub
DBAUTHSOURCE=studenthub
PORT=8890
LogPath=logs
assetsPath=../FrontEndExample/dist/assets
HomePagePath=../FrontEndExample/dist/index.html
privateKey=replace_with_a_random_local_secret
